{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "baseline",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "enum": [
        1
      ]
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "file",
          "hash"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "rule",
    "count",
    "locations"
  ],
  "additionalProperties": false
}

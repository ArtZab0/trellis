{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task-spec",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "enum": [
        1
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "accept": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "tierCeiling": {
      "type": "number",
      "enum": [
        0,
        1,
        2,
        3
      ]
    },
    "budget": {
      "type": "object",
      "properties": {
        "usd": {
          "type": "number",
          "minimum": 0
        },
        "wallMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "usd",
        "wallMinutes",
        "attempts"
      ],
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "runner"
      ],
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "maintenance",
        "construction"
      ]
    },
    "workstream": {
      "type": "string",
      "minLength": 1
    },
    "areaAgent": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "setBy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "metric",
        "value",
        "setBy"
      ],
      "additionalProperties": false
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "version",
    "id",
    "goal",
    "features",
    "accept",
    "tierCeiling",
    "budget",
    "mode"
  ],
  "additionalProperties": false
}

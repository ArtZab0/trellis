{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "enum": [
        1
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "area": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "number",
      "enum": [
        0,
        1,
        2,
        3
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "object",
      "properties": {
        "route": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "driver": {
      "type": "string",
      "minLength": 1
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "says": {
            "type": "string",
            "minLength": 1
          },
          "impl": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "says",
          "impl"
        ],
        "additionalProperties": false
      }
    },
    "budgets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "max": {
            "type": "number"
          }
        },
        "required": [
          "metric",
          "max"
        ],
        "additionalProperties": false
      }
    },
    "touches": {
      "type": "object",
      "properties": {
        "code": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "code",
        "data"
      ],
      "additionalProperties": false
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "version",
    "id",
    "title",
    "area",
    "tier",
    "owner",
    "entry",
    "clauses",
    "properties"
  ],
  "additionalProperties": false
}

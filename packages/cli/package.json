{
  "name": "@trellis/cli",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@trellis/core": "workspace:*",
    "@trellis/github": "workspace:*",
    "@trellis/schema": "workspace:*",
    "effect": "4.1.4"
  },
  "bin": {
    "trellis": "./dist/live/bin.js"
  }
}
